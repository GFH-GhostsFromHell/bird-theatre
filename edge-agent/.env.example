# Run recognition on a camera-side computer. Never put your secrets in git.
PORTAL_URL=https://bird-theatre.onrender.com
CAMERA_ID=YOUR_CAMERA_UUID
DEVICE_TOKEN=YOUR_PRIVATE_CAMERA_TOKEN
# RTSP IP camera, local video file, or '0' for your first USB webcam
CAMERA_SOURCE=rtsp://192.168.1.100:554/stream
VISION_DEVICE=auto
# Select local species candidates; replace with your own CSV for other regions.
SPECIES_CSV=species_ontario.csv
SAMPLE_SECONDS=1.5
DETECTOR_MIN_SCORE=0.65
MIN_CONFIRM_FRAMES=2
ABSENCE_SECONDS=10
SPECIES_MIN_SIMILARITY=0.18
SPECIES_MIN_MARGIN=0.025
EVENT_QUEUE_FILE=.spool/events.sqlite3
# Serial RFID bridge (separate process)
RFID_SERIAL_PORT=/dev/ttyUSB0
RFID_BAUD=9600
# Legacy ONNX reference (no included species model)
VISION_MODEL=bird-species.onnx
VISION_LABELS=species.txt
MIN_CONFIDENCE=0.75
